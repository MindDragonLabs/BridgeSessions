# bs-server.service — systemd user service for the BridgeSessions monolith
#
# Installation (per-user):
#   mkdir -p ~/.config/systemd/user
#   cp bs-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now bs-server.service
#
# Status & logs:
#   systemctl --user status bs-server.service
#   journalctl --user -u bs-server.service -f
#
# Requirements:
#   - /usr/local/bin/bridgesessions must exist and be executable
#   - ~/.bridgesessions/config must contain the node name, listen address, and
#     pinned peers. Identity files are generated under the same app home.

[Unit]
Description=BridgeSessions mesh daemon
Documentation=https://codeberg.org/Mind-Dragon/BridgeSessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Adjust ExecStart if the monolith lives elsewhere (for example ~/.local/bin).
ExecStart=/usr/local/bin/bridgesessions --config %h/.bridgesessions/config

# Restart policy — always bring the daemon back up after a crash.
Restart=always
RestartSec=5

# Do not add ProtectHome/ProtectSystem/NoNewPrivileges blindly: authorized peers
# intentionally receive the daemon account's shell and file permissions.

# Logging goes to the journal (stdout/stderr captured automatically).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
