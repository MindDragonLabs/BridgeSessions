# Shadow production — install-daemon copies this if config missing or node.name starts with gossip
node.name Shadow
node.listen 0.0.0.0:19949

mesh.max_peers 50
mesh.gossip_interval_secs 300
mesh.reconnect_backoff_max_secs 30
mesh.ping_interval_secs 60
mesh.pong_timeout_secs 30
transport.webrtc_enabled false
dht.enabled false
upnp.enabled false

seed test-pc2 203.0.113.20:19949
seed test-pc1 203.0.113.10:19949

sessions.scrollback_lines 100
sessions.idle_timeout_hours 168
sessions.default_shell cmd.exe
sessions.terminal xterm-256color
sessions.persistence_path ~/.bridgesessions/sessions.json
sessions.authorized_keys_path ~/.bridgesessions/authorized_keys