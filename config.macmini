# bridgesessions mesh config
node.name macos-peer
node.listen 0.0.0.0:19949
mesh.max_peers 50
mesh.gossip_interval_secs 30
mesh.reconnect_backoff_max_secs 30
mesh.ping_interval_secs 5
mesh.pong_timeout_secs 30
transport.webrtc_enabled false
dht.enabled false
upnp.enabled false
seed shadow 100.124.169.66:19949 pubkey=e702d6ad10e1891f4fc2a7764df40eef5e3e459b971654996353bc34f8e936bc
seed linux-a 203.0.113.11:19949 pubkey=80f749207dabc1213ce7b491636f701556cecfa8808bcb2cf3f347bc4bf7c2b8
seed linux-b 203.0.113.12:19949 pubkey=358e0bb8b4e3bc245139a6678554b47c3306e8e553ff02f60e912b27590ace52
sessions.scrollback_lines 1000
sessions.idle_timeout_hours 168
sessions.default_shell /bin/zsh -l
sessions.terminal xterm-256color
sessions.persistence_path ~/.bridgesessions/sessions.json
sessions.authorized_keys_path ~/.bridgesessions/authorized_keys
