# Portable Linux x86_64 release builder (Ubuntu 22.04 glibc floor).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build make perl wget ca-certificates gnupg file \
    pkg-config git && \
    wget -qO- "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xC8EC952E2A0E1FBDC5090F6A2C277A0A352154E5" \
      | gpg --dearmor -o /etc/apt/trusted.gpg.d/ubuntu-toolchain-r.gpg && \
    echo "deb https://ppa.launchpadcontent.net/ubuntu-toolchain-r/test/ubuntu jammy main" \
      > /etc/apt/sources.list.d/toolchain.list && \
    apt-get update && apt-get install -y --no-install-recommends g++-13 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 60 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 60 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# CMake >= 3.25.
RUN wget -q https://github.com/Kitware/CMake/releases/download/v3.28.3/cmake-3.28.3-linux-x86_64.tar.gz && \
    tar xf cmake-3.28.3-linux-x86_64.tar.gz -C /opt && \
    ln -sf /opt/cmake-3.28.3-linux-x86_64/bin/cmake /usr/local/bin/cmake && \
    ln -sf /opt/cmake-3.28.3-linux-x86_64/bin/ctest /usr/local/bin/ctest && \
    rm cmake-3.28.3-linux-x86_64.tar.gz

# OpenSSL 3.5 LTS (supported through April 2030).
RUN wget -q https://www.openssl.org/source/openssl-3.5.7.tar.gz && \
    tar xf openssl-3.5.7.tar.gz && cd openssl-3.5.7 && \
    ./Configure linux-x86_64 no-shared no-tests --prefix=/opt/ossl && \
    make -j2 && make install_sw && cd /build && rm -rf openssl-3.5.7*

# zstd 1.5.7.
RUN wget -q https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz && \
    tar xf zstd-1.5.7.tar.gz && cd zstd-1.5.7/build/cmake && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DZSTD_BUILD_SHARED=OFF \
      -DCMAKE_INSTALL_PREFIX=/opt/zstd -B build . && \
    cmake --build build -j2 && cmake --install build && \
    cd /build && rm -rf zstd-1.5.7*

# fmt 12.2 + spdlog 1.17 (fixes CVE-2025-6140, affected through 1.15.1).
RUN wget -q https://github.com/fmtlib/fmt/archive/refs/tags/12.2.0.tar.gz -O fmt.tar.gz && \
    tar xf fmt.tar.gz && cd fmt-12.2.0 && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
      -DFMT_TEST=OFF -DFMT_DOC=OFF -DCMAKE_INSTALL_PREFIX=/opt/fmt -B build . && \
    cmake --build build -j2 && cmake --install build && \
    cd /build && rm -rf fmt-12.2.0 fmt.tar.gz
RUN wget -q https://github.com/gabime/spdlog/archive/refs/tags/v1.17.0.tar.gz -O spdlog.tar.gz && \
    tar xf spdlog.tar.gz && cd spdlog-1.17.0 && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
      -DSPDLOG_FMT_EXTERNAL=ON -DCMAKE_PREFIX_PATH=/opt/fmt \
      -DCMAKE_INSTALL_PREFIX=/opt/spdlog -B build . && \
    cmake --build build -j2 && cmake --install build && \
    cd /build && rm -rf spdlog-1.17.0 spdlog.tar.gz

# Header-only runtime dependencies.
RUN wget -q https://github.com/nlohmann/json/archive/refs/tags/v3.12.0.tar.gz -O json.tar.gz && \
    tar xf json.tar.gz && cd json-3.12.0 && \
    cmake -GNinja -DJSON_BuildTests=OFF -DCMAKE_INSTALL_PREFIX=/opt/json -B build . && \
    cmake --install build && cd /build && rm -rf json-3.12.0 json.tar.gz
RUN wget -q https://github.com/CLIUtils/CLI11/archive/refs/tags/v2.7.2.tar.gz -O cli11.tar.gz && \
    tar xf cli11.tar.gz && cd CLI11-2.7.2 && \
    cmake -GNinja -DCLI11_BUILD_TESTS=OFF -DCMAKE_INSTALL_PREFIX=/opt/cli11 -B build . && \
    cmake --install build && cd /build && rm -rf CLI11-2.7.2 cli11.tar.gz

WORKDIR /src
COPY . /src
RUN cmake -GNinja -S . -B build \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      -DCMAKE_PREFIX_PATH="/opt/ossl;/opt/zstd;/opt/fmt;/opt/spdlog;/opt/json;/opt/cli11" \
      -DOPENSSL_ROOT_DIR=/opt/ossl -DZSTD_ROOT=/opt/zstd -DSPDLOG_ROOT=/opt/spdlog \
      -DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON \
      -DCMAKE_EXE_LINKER_FLAGS="-static-libstdc++ -static-libgcc" && \
    cmake --build build --target bridgesessions -j2

RUN file /src/build/bridgesessions && ldd /src/build/bridgesessions
